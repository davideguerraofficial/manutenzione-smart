---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Pricing from '../components/Pricing.astro';
import Documents from '../components/Documents.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import OurStory from '../components/OurStory.astro';
import ContactChannels from '../components/ContactChannels.astro';
import { site } from '../data/site';
import { services, steps, roadmap } from '../data/services';
import { faq } from '../data/faq';
import { path, emailLink } from '../lib/links';
import fascicolo from '../assets/fascicolo-completo.png';
const structured = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, description: site.description, email: site.email, sameAs: [site.social.instagram.url, ...(site.social.facebook.enabled ? [site.social.facebook.url] : [])], ...(Astro.site ? { url: new URL(path(), Astro.site).href } : {}) };
---
<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structured)} />
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="eyebrow-line"></span>PER CHI SI PRENDE CURA DELL’OSPITALITÀ</span>
        <h1 id="hero-title">La manutenzione,<br />finalmente<br /><em>in ordine.</em></h1>
        <p class="hero-description">Tu fotografi la targhetta. Al resto pensiamo noi.<br />Manuali, apparecchiature e scadenze in un fascicolo chiaro. Per dedicare più tempo alla tua struttura.</p>
        <div class="hero-actions"><a class="button" href={emailLink(site.email)}><Icon name="mail" size={20} />Richiedi un esempio gratuito</a><a class="text-link" href="#esempi">Sfoglia gli esempi</a></div>
        <p class="hero-note">Per B&B, affittacamere e piccole strutture ricettive.</p>
        <div class="hero-trust"><Icon name="clock" size={18} /><span>Un servizio che svolgiamo già da quasi un anno.</span></div>
      </div>
      <div class="hero-visual">
        <div class="folio-label"><span>IL TUO FASCICOLO</span><span>01 / TUTTO IN ORDINE</span></div>
        <a class="hero-document" href={path('documenti/02_MANUTENZIONE_SMART_COMPLETO_ESEMPIO.pdf')} target="_blank" rel="noopener" aria-label="Sfoglia il fascicolo Completo, PDF, nuova scheda"><Image src={fascicolo} width={490} height={693} alt="Pagina reale del fascicolo Completo: inventario, stato documenti e indice cliccabile" loading="eager" fetchpriority="high" /></a>
        <div class="folio-caption"><Icon name="files" size={20} /><span>Un esempio reale del formato.<br /><strong>Documenti chiari. Informazioni ritrovabili.</strong></span></div>
        <span class="visual-number" aria-hidden="true">MS / 2026</span>
      </div>
    </div>
    <div class="container hero-bottom"><span>DALLE FOTO AL FASCICOLO</span><span><Icon name="check" size={17} /> Manuali ufficiali disponibili</span><span><Icon name="check" size={17} /> File già compilati</span><span><Icon name="check" size={17} /> Tu scegli quanto delegare</span></div>
  </section>
  <section class="section service-section" id="servizio" aria-labelledby="service-title">
    <div class="container">
      <div class="section-heading split-heading" data-reveal><div><span class="eyebrow">MENO RICERCHE, PIÙ CHIAREZZA</span><h2 id="service-title">Il manuale giusto.<br />Al momento giusto.</h2></div><p>Una targhetta in foto, una garanzia da ritrovare, una scadenza da ricordare. Mettiamo insieme le informazioni che servono, senza lasciare tutto nella memoria di chi gestisce.</p></div>
      <div class="services-grid">{services.map((service, i) => <article class="service-card" data-reveal><div class="service-top"><span class="icon-tile"><Icon name={service.icon} size={27} /></span><span class="section-index">0{i + 1}</span></div><h3>{service.title}</h3><p>{service.text}</p></article>)}</div>
      <div class="scope-note" data-reveal><Icon name="shield" size={24} /><p><strong>Informazioni organizzate, responsabilità chiare.</strong> Distinguiamo le attività utente dagli interventi riservati ai tecnici. Il servizio non sostituisce diagnosi, certificazioni o valutazioni dei professionisti.</p></div>
    </div>
  </section>
  <ServiceCatalog />
  <section class="section process-section" id="come-funziona" aria-labelledby="process-title">
    <div class="container process-grid">
      <div class="section-heading" data-reveal><span class="eyebrow">UN INIZIO SEMPLICE</span><h2 id="process-title">Si parte da<br /><em>una foto.</em></h2><p>Non devi preparare un archivio perfetto.<br />Basta cominciare da quello che hai.</p><a class="button button-light" href={emailLink(site.email)}>Raccontaci la tua struttura</a></div>
      <ol class="steps-list">{steps.map((step, i) => <li data-reveal><span class="step-number">0{i + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
    </div>
  </section>
  <OurStory />
  <Pricing />
  <section class="section delegation-section" aria-labelledby="delegation-title"><div class="container delegation-grid">
    <div class="section-heading" data-reveal><span class="eyebrow">CON LA GESTIONE CONTINUATIVA</span><h2 id="delegation-title">Dalla scadenza<br />alla scelta del tecnico.</h2><p>Quando serve un intervento, ti aiutiamo a cercare, confrontare e organizzare. La decisione finale resta tua.</p><a class="text-link" href="#piani" data-open-subscriptions>Scopri gli abbonamenti</a></div>
    <div class="delegation-flow" data-reveal><div class="flow-item"><span>01</span><div><h3>Prepariamo la richiesta</h3><p>Modello, documenti e necessità, raccolti insieme.</p></div></div><div class="flow-item"><span>02</span><div><h3>Confrontiamo le alternative</h3><p>Obiettivo 3–5 proposte disponibili, con preventivi, fonti e recensioni.</p></div></div><div class="flow-item"><span>03</span><div><h3>Tu approvi. Noi coordiniamo.</h3><p>Appuntamento e aggiornamento dei documenti ricevuti dopo l’intervento.</p></div></div><div class="commission-note"><strong>0</strong><span>commissioni sugli interventi.<br />Paghi il professionista direttamente.</span></div></div>
  </div></section>
  <Documents />
  <section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div class="section-heading" data-reveal><span class="eyebrow">PRIMA DI INIZIARE</span><h2 id="faq-title">Facciamo<br />chiarezza.</h2><p>Le risposte alle domande più utili<br />per scegliere il tuo percorso.</p><a class="text-link" href={emailLink(site.email, 'Informazioni Manutenzione Smart')}>Scrivici per saperne di più</a></div><div class="faq-list">{faq.map(item => <details><summary>{item.question}<Icon name="plus" size={20} /></summary><p>{item.answer}</p></details>)}</div></div></section>
  <section class="roadmap-section" aria-labelledby="roadmap-title"><div class="container"><div class="roadmap-heading"><span class="eyebrow">UN SERVIZIO CHE CRESCE CON TE</span><h2 id="roadmap-title">Un passo alla volta.</h2></div><div class="roadmap-grid">{roadmap.map(item => <div class:list={['roadmap-item', { available: item.available }]}><span>{item.phase}</span><h3>{item.title}</h3><p>{item.text}</p></div>)}</div></div></section>
  <section class="contact-section" id="contatti" aria-labelledby="contact-title"><div class="container contact-inner" data-reveal><span class="eyebrow">COMINCIAMO DALLA TUA STRUTTURA</span><h2 id="contact-title">Meno cose da ricordare.<br /><em>Più tempo per accogliere.</em></h2><p>Guarda un esempio e raccontaci di cosa hai bisogno.<br />Troviamo insieme il modo di fare ordine.</p><a class="button button-light" href={emailLink(site.email)}><Icon name="mail" size={20} />Richiedi un esempio gratuito</a><ContactChannels /></div></section>
</BaseLayout>
