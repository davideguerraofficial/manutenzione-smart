---
import { faq } from '../data/faq';
import { site } from '../data/site';
import { emailLink } from '../lib/links';
import Icon from './Icon.astro';
---
<section class="section faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-grid"><div class="section-heading" data-reveal><span class="eyebrow">PRIMA DI INIZIARE</span><h2 id="faq-title">Facciamo<br />chiarezza.</h2><p>Costi, inclusioni e responsabilità: le risposte per scegliere consapevolmente.</p><a class="text-link" href={emailLink(site.email, 'Informazioni Manutenzione Smart')}>Scrivici per saperne di più</a></div><div class="faq-list">{faq.map(item => <details><summary>{item.question}<Icon name="plus" size={20} /></summary><p>{item.answer}</p></details>)}</div></div></section>
